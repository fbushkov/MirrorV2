{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "fallbackModel": ["sonnet"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"", "timeout": 15, "statusMessage": "Восстанавливаю память проекта" }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 10, "async": true }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 20, "async": true }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 10, "async": true }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 10, "async": true }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 20 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 20 }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 30, "statusMessage": "Сохраняю снапшот перед сжатием контекста" }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-event.mjs\"", "timeout": 30 }] }
    ]
  }
}
