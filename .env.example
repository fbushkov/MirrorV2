# Переменные окружения Mirror V2. Значения — только в .env.local / секретах CI, в git не попадают.
# Появляются по мере этапов из docs/architecture/site.md.

# Этап 2 — приём заявок (ADR-0003)
# DATABASE_URL=postgres://user:password@localhost:5432/mirror
# SMTP_URL=smtp://user:password@smtp.example.ru:465
# LEADS_NOTIFY_EMAIL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# IP_HASH_SALT=

# Этап 3–4 — вход в кабинет и админку (ADR-0004)
# AUTH_SECRET=

# Аналитика (после согласия на cookies)
# NEXT_PUBLIC_YM_ID=
